@using PersonalInformation.Services
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS
@inject ThemeService ThemeService
@implements IDisposable

<header class="hdr" @onkeydown="OnKeyDown">
    <div class="hdr-bar">
        <a href="/" class="hdr-logo" aria-label="CrossPlatformDev home" @onclick="Close">
            <img src="img/logo-icon.png" alt="CrossPlatformDev" height="48" fetchpriority="high" />
        </a>

        <nav id="primary-nav" class="hdr-nav @(_open ? "open" : "")" aria-label="Primary">
            <NavLink href="/" Match="NavLinkMatch.All" @onclick="Close">Home</NavLink>
            <NavLink href="/services" @onclick="Close">Services</NavLink>
            <NavLink href="/portfolio" @onclick="Close">Portfolio</NavLink>
            <NavLink href="/about" @onclick="Close">About</NavLink>
            <NavLink href="/blog" @onclick="Close">Blog</NavLink>
            <a href="/contact" class="hdr-cta-mobile" @onclick="Close">Start a project</a>
        </nav>

        <div class="hdr-actions">
            <button type="button" class="hdr-icon-btn" @onclick="ToggleTheme"
                    aria-label="@(ThemeService.IsDark ? "Switch to light theme" : "Switch to dark theme")">
                @if (ThemeService.IsDark)
                {
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                }
            </button>

            <a href="/contact" class="btn btn-primary hdr-cta">Start a project</a>

            <button type="button" class="hdr-burger @(_open ? "active" : "")" @onclick="Toggle"
                    aria-label="@(_open ? "Close menu" : "Open menu")" aria-expanded="@(_open ? "true" : "false")" aria-controls="primary-nav">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

@if (_open)
{
    <button type="button" class="hdr-scrim" aria-label="Close menu" tabindex="-1" @onclick="Close"></button>
}

@code {
    private bool _open;

    protected override void OnInitialized() => ThemeService.OnThemeChanged += OnThemeChanged;

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _open = false;
    }

    private async Task ToggleTheme()
    {
        ThemeService.ToggleTheme();
        await JS.InvokeVoidAsync("localStorage.setItem", "theme", ThemeService.CurrentTheme);
    }

    public void Dispose() => ThemeService.OnThemeChanged -= OnThemeChanged;
}
