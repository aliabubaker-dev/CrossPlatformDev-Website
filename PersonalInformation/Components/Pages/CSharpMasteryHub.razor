                        <img src="/img/cs_home.png" alt="C# Mastery Hub homepage" loading="lazy" />
                        <span class="cs-gallery-shine"></span>
                    </div>
                    <figcaption>
                        <span class="cs-gallery-index">01</span>
                        <div>
                            <p class="cs-gallery-title">Homepage — Hero &amp; Learning Path</p>
