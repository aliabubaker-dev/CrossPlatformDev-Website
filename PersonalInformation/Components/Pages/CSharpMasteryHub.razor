</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/portfolio.js");
            await module.InvokeVoidAsync("portfolioPageInit");
        }
    }
}