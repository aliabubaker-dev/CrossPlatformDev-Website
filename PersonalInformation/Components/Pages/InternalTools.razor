@page "/portfolio/internal-tools"
@page "/internal-tools"
@inject IJSRuntime JS

<SeoHead Title="Custom Business Systems for Barza Security | DMS, Operations & HR"
         Description="See the real custom .NET business systems I built for Barza Security Company, including a Document Management System (DMS), Operations Room for contracts, and a Notification System for HR and Admin."
         Path="/portfolio/internal-tools" />

<div class="page-enter">

    <!-- ===== HERO SECTION ===== -->
    <section class="tools-hero section">
        <div class="container">
            <div class="tools-hero-grid">
                <div class="tools-hero-content">
                    <div class="tools-badge reveal" style="--stagger-index:0">
                        <span class="badge-dot"></span>
                        <span>Internal Business Tools</span>
                    </div>
                    <h1 class="tools-headline reveal" style="--stagger-index:1">
                        <span class="tools-line">Systems that</span>
                        <span class="tools-line tools-line-gradient">run real businesses.</span>
                    </h1>
                    <p class="tools-description reveal" style="--stagger-index:2">
                        Custom business management systems built for Barza Security Company using .NET Framework and C#.
                        From managing official documents to tracking operations and HR notifications — I build software that powers daily operations.
                    </p>
                </div>
                <div class="tools-hero-visual reveal" style="--stagger-index:2">
                    <div class="tools-orb"></div>
                    <div class="tools-icon-grid">
                        <div class="tools-icon-card floaty" style="animation-delay: 0s;">
                            <span class="tools-icon">🗂️</span>
                            <span class="tools-icon-label">DMS</span>
                        </div>
                        <div class="tools-icon-card floaty" style="animation-delay: 0.8s;">
                            <span class="tools-icon">📋</span>
                            <span class="tools-icon-label">Ops</span>
                        </div>
                        <div class="tools-icon-card floaty" style="animation-delay: 1.6s;">
                            <span class="tools-icon">🔔</span>
                            <span class="tools-icon-label">Notify</span>
                        </div>
                        <div class="tools-icon-card floaty" style="animation-delay: 0.4s;">
                            <span class="tools-icon">👔</span>
                            <span class="tools-icon-label">HR</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== SYSTEMS DETAIL ===== -->
    <section class="tools-systems section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">the-systems</span>
                <h2>Every system I've built<br><span class="grad-text">for Barza Security.</span></h2>
            </div>

            <div class="systems-grid">
                <!-- System 1: DMS -->
                <div class="system-card reveal" style="--stagger-index:0">
                    <div class="system-card-image-wrapper">
                        <img src="img/dms-system.jpg" alt="DMS System Screenshot" class="system-card-image" />
                    </div>
                    <div class="system-card-header">
                        <div class="system-card-icon">🗂️</div>
                        <div class="system-card-info">
                            <h3>Document Management System (DMS)</h3>
                            <span class="system-card-category">.NET Framework · C# · SQL Server</span>
                        </div>
                        <div class="system-card-number">01</div>
                    </div>
                    <p class="system-card-description">
                        A complete system for managing incoming and outgoing documents (صادرة - واردة) for Barza Security. Tracks letter numbers, dates, senders, and responses.
                    </p>
                    <div class="system-card-features">
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Track incoming & outgoing letters</span></div>
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Attach scanned PDF documents</span></div>
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Search by place, number, year</span></div>
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Print formatted reports</span></div>
                    </div>
                    <div class="system-card-tech">
                        <span class="tech-pill">C#</span>
                        <span class="tech-pill">WinForms</span>
                        <span class="tech-pill">SQL Server</span>
                        <span class="tech-pill">Printing</span>
                    </div>
                </div>

                <!-- System 2: Operations Room -->
                <div class="system-card reveal" style="--stagger-index:1">
                    <div class="system-card-image-wrapper">
                        <img src="img/operations-system.jpg" alt="Operations Room System Screenshot" class="system-card-image" />
                    </div>
                    <div class="system-card-header">
                        <div class="system-card-icon">📋</div>
                        <div class="system-card-info">
                            <h3>Operations Room System</h3>
                            <span class="system-card-category">.NET Framework · C# · SQL Server</span>
                        </div>
                        <div class="system-card-number">02</div>
                    </div>
                    <p class="system-card-description">
                        A powerful system for Barza Security to manage client projects and security contracts. Create, edit, delete, and archive contracts with real-time tracking of guards, weapons, and vehicles.
                    </p>
                    <div class="system-card-features">
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Create client projects</span></div>
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Manage staff & salaries</span></div>
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Track weapons & vehicles</span></div>
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Print A4 formatted reports</span></div>
                    </div>
                    <div class="system-card-tech">
                        <span class="tech-pill">C#</span>
                        <span class="tech-pill">.NET Framework</span>
                        <span class="tech-pill">SQL Server</span>
                        <span class="tech-pill">CRUD</span>
                    </div>
                </div>

                <!-- System 3: Notification System -->
                <div class="system-card reveal" style="--stagger-index:2">
                    <div class="system-card-image-wrapper">
                        <img src="img/notification-system.jpg" alt="Notification System Screenshot" class="system-card-image" />
                    </div>
                    <div class="system-card-header">
                        <div class="system-card-icon">🔔</div>
                        <div class="system-card-info">
                            <h3>Notification System</h3>
                            <span class="system-card-category">.NET Framework · C# · SQL Server</span>
                        </div>
                        <div class="system-card-number">03</div>
                    </div>
                    <p class="system-card-description">
                        An automated notification system that alerts HR, Office, Store, and Lawyer departments about new, updated, or deleted projects. Ensures every department is always informed.
                    </p>
                    <div class="system-card-features">
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Real-time project alerts</span></div>
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Color-coded status (New, Edit, Delete)</span></div>
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Department confirmation tracking</span></div>
                        <div class="feature-item"><span class="feature-icon">✅</span><span>Detailed review dialog</span></div>
                    </div>
                    <div class="system-card-tech">
                        <span class="tech-pill">C#</span>
                        <span class="tech-pill">.NET Framework</span>
                        <span class="tech-pill">SQL Server</span>
                        <span class="tech-pill">Workflow</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== NEW STATS SECTION (REDESIGNED) ===== -->
    <section class="tools-stats-section section-tight">
        <div class="container">
            <div class="stats-modern-grid">
                <div class="stat-card-modern reveal" style="--stagger-index:0">
                    <div class="stat-icon-modern">📦</div>
                    <span class="stat-number-modern">3</span>
                    <span class="stat-label-modern">Systems Built</span>
                </div>
                <div class="stat-card-modern reveal" style="--stagger-index:1">
                    <div class="stat-icon-modern">👥</div>
                    <span class="stat-number-modern">300+</span>
                    <span class="stat-label-modern">Users Supported</span>
                </div>
                <div class="stat-card-modern reveal" style="--stagger-index:2">
                    <div class="stat-icon-modern">🛡️</div>
                    <span class="stat-number-modern">100%</span>
                    <span class="stat-label-modern">Data Integrity</span>
                </div>
                <div class="stat-card-modern reveal" style="--stagger-index:3">
                    <div class="stat-icon-modern">⚡</div>
                    <span class="stat-number-modern">24/7</span>
                    <span class="stat-label-modern">Operations</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="section-tight">
        <div class="container">
            <div class="reveal cta-banner">
                <span class="eyebrow" style="justify-content: center;">need-something-similar</span>
                <h2 style="font-size: 2rem;">Want a custom system<br>for <span class="grad-text">your business?</span></h2>
                <p style="max-width: 500px; margin: 0 auto var(--space-5);">Let's build software that streamlines your operations.</p>
                <a href="/contact" class="btn btn-primary">Start Your Project</a>
            </div>
        </div>
    </section>

</div>

<style>
    /* ===== TOOLS HERO ===== */
    .tools-hero {
        padding-top: var(--space-4);
    }

    .tools-hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-8);
        align-items: center;
        min-height: 50vh;
    }

    .tools-hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .tools-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        background: rgba(0, 229, 255, 0.08);
        border: 1px solid rgba(0, 229, 255, 0.15);
        border-radius: 999px;
        padding: 6px 16px 6px 10px;
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--accent-cyan);
        width: fit-content;
        font-family: var(--font-mono);
    }

    .tools-headline {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .tools-line-gradient {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .tools-description {
        font-size: 1.1rem;
        max-width: 480px;
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0;
    }

    /* ===== TOOLS VISUAL ===== */
    .tools-hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    .tools-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle at center, rgba(0, 229, 255, 0.06), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: floatY 8s ease-in-out infinite;
    }

    .tools-icon-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
        position: relative;
        z-index: 1;
    }

    .tools-icon-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        width: 110px;
        height: 110px;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        transition: transform 0.4s var(--ease-out-expo), border-color 0.4s, box-shadow 0.4s;
        cursor: default;
    }

        .tools-icon-card:hover {
            transform: translateY(-8px) scale(1.05);
            border-color: var(--border-glow);
            box-shadow: 0 20px 60px rgba(0, 229, 255, 0.08);
        }

    .tools-icon {
        font-size: 2.4rem;
        line-height: 1;
    }

    .tools-icon-label {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
    }

    /* ===== SYSTEMS GRID ===== */
    .tools-systems {
        padding: var(--space-8) 0;
        background: rgba(0, 0, 0, 0.15);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
    }

    .systems-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-5);
        margin-top: var(--space-6);
    }

    .system-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        transition: transform 0.4s var(--ease-out-expo), border-color 0.4s, box-shadow 0.4s;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        position: relative;
        overflow: hidden;
    }

        .system-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--accent-gradient);
            opacity: 0;
            transition: opacity 0.4s;
        }

        .system-card:hover::before {
            opacity: 1;
        }

        .system-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
        }

    /* ===== PROOF IMAGE STYLES ===== */
    .system-card-image-wrapper {
        width: 100%;
        height: 220px;
        overflow: hidden;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-subtle);
        background: var(--bg-void);
        position: relative;
        margin-bottom: var(--space-2);
    }

    .system-card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        transition: transform 0.6s var(--ease-out-expo), filter 0.6s ease;
        cursor: zoom-in;
        display: block;
    }

    .system-card:hover .system-card-image {
        transform: scale(1.08);
        filter: brightness(1.1);
    }

    .system-card-image-wrapper::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 60px;
        background: linear-gradient(to top, var(--bg-surface) 0%, transparent 100%);
        pointer-events: none;
    }

    .system-card-header {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
        position: relative;
    }

    .system-card-icon {
        font-size: 2rem;
        line-height: 1;
        flex-shrink: 0;
        width: 48px;
        text-align: center;
    }

    .system-card-info {
        flex: 1;
    }

        .system-card-info h3 {
            font-size: 1.1rem;
            margin: 0;
            font-family: var(--font-display);
            font-weight: 600;
        }

    .system-card-category {
        font-size: 0.72rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        display: block;
        margin-top: 2px;
    }

    .system-card-number {
        font-family: var(--font-mono);
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent-cyan);
        opacity: 0.1;
        line-height: 1;
        flex-shrink: 0;
        position: absolute;
        right: 0;
        top: 0;
    }

    .system-card-description {
        font-size: 0.92rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
        padding-right: var(--space-2);
    }

    .system-card-features {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-1) var(--space-3);
        margin: var(--space-1) 0;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        font-size: 0.82rem;
        color: var(--text-secondary);
        padding: 2px 0;
    }

    .feature-icon {
        font-size: 0.7rem;
        color: var(--success);
        flex-shrink: 0;
    }

    .system-card-tech {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
        margin-top: var(--space-1);
    }

    .tech-pill {
        font-size: 0.6rem;
        font-family: var(--font-mono);
        padding: 2px 10px;
        border-radius: 999px;
        border: 1px solid var(--border-subtle);
        color: var(--text-muted);
        background: rgba(0, 0, 0, 0.2);
    }

    /* ===== NEW STATS SECTION (REDESIGNED) ===== */
    .tools-stats-section {
        padding: var(--space-6) 0;
    }

    .stats-modern-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
    }

    .stat-card-modern {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: transform 0.4s var(--ease-out-expo), border-color 0.4s, box-shadow 0.4s;
    }

        .stat-card-modern::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--accent-gradient);
            opacity: 0;
            transition: opacity 0.4s;
        }

        .stat-card-modern:hover::before {
            opacity: 1;
        }

        .stat-card-modern:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
        }

    .stat-icon-modern {
        font-size: 2.2rem;
        line-height: 1;
        margin-bottom: var(--space-1);
        filter: drop-shadow(0 0 15px rgba(0, 229, 255, 0.2));
    }

    .stat-number-modern {
        font-family: var(--font-display);
        font-size: 2.2rem;
        font-weight: 700;
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        line-height: 1.1;
    }

    .stat-label-modern {
        font-size: 0.82rem;
        color: var(--text-muted);
        font-weight: 500;
        letter-spacing: 0.02em;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .tools-hero-grid {
            grid-template-columns: 1fr;
            min-height: auto;
            gap: var(--space-6);
        }

        .tools-hero-content {
            order: 1;
        }

        .tools-hero-visual {
            order: 0;
        }

        .tools-headline {
            font-size: clamp(2rem, 4vw, 2.8rem);
        }

        .tools-description {
            font-size: 1rem;
            max-width: 100%;
        }

        .systems-grid {
            grid-template-columns: 1fr 1fr;
        }

        .system-card-features {
            grid-template-columns: 1fr;
        }

        .stats-modern-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .systems-grid {
            grid-template-columns: 1fr;
        }

        .tools-icon-card {
            width: 80px;
            height: 80px;
        }

        .tools-icon {
            font-size: 1.8rem;
        }

        .tools-orb {
            width: 250px;
            height: 250px;
        }

        .system-card-number {
            font-size: 1.4rem;
        }

        .stat-card-modern {
            padding: var(--space-4);
        }

        .stat-number-modern {
            font-size: 1.8rem;
        }

        .stat-icon-modern {
            font-size: 1.8rem;
        }
    }

    @@media (max-width: 480px) {
        .tools-icon-grid {
            gap: var(--space-2);
        }

        .tools-icon-card {
            width: 60px;
            height: 60px;
        }

        .tools-icon {
            font-size: 1.4rem;
        }

        .tools-icon-label {
            font-size: 0.55rem;
        }

        .system-card {
            padding: var(--space-4);
        }

        .system-card-header {
            flex-wrap: wrap;
        }

        .system-card-number {
            position: static;
            font-size: 1.2rem;
        }

        .stats-modern-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load the JS module from the wwwroot/js folder
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/internal-tools.js");
            await module.InvokeVoidAsync("initInternalTools");
        }
    }
}