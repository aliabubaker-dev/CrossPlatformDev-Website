    private GalleryImage? selectedImage;
    private int selectedIndex = -1;

    private void OpenLightbox(int index)
    {
        selectedIndex = index;
        selectedImage = galleryImages[index];
    }

    private void CloseLightbox()
    {
        selectedImage = null;
        selectedIndex = -1;
    }

    private void PrevImage()
    {
        if (selectedIndex > 0)
        {
            selectedIndex--;
            selectedImage = galleryImages[selectedIndex];
        }
    }

    private void NextImage()
    {
        if (selectedIndex < galleryImages.Count - 1)
        {
            selectedIndex++;
            selectedImage = galleryImages[selectedIndex];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Trigger the site-wide animations (scroll reveal etc.)
            await JS.InvokeVoidAsync("siteAnimations.initAll");
        }
    }

