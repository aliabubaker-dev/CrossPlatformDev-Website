@page "/contact"
@using Microsoft.AspNetCore.Components.Forms
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@inject IConfiguration Config
@inject IHttpClientFactory HttpClientFactory
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject ILogger<Contact> Logger

<SeoHead Title="Contact CrossPlatformDev | Website & App Development Quote"
         Description="Contact CrossPlatformDev to start a website, Android or iOS app, or business system project. Send a message and you will hear back within a day."
         Path="/contact" />

<HeadContent>
    <script type="application/ld+json">@((MarkupString)_jsonLd)</script>
</HeadContent>

<div class="ct-root">
    <div class="container">

        <nav class="ct-crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><i aria-hidden="true">/</i><b aria-current="page">Contact</b>
        </nav>

        <header class="ct-top">
            <h1 class="ct-h1">Contact CrossPlatformDev</h1>
            <p class="ct-lead">
                Tell us about your website, Android or iOS app, or business system. You will hear back within a day.
                Want examples first? <a href="/portfolio">Browse our portfolio</a> or <a href="/services">read about our services</a>.
            </p>
        </header>

        <div class="ct-layout">

            <!-- ===== Conversation ===== -->
            <section class="ct-wiz" aria-label="Contact form" aria-live="polite">
                @if (submitted)
                {
                    <div class="ct-sent">
                        <h2 class="ct-q" @ref="doneHeading" tabindex="-1">Brief sent@(FirstName.Length > 0 ? ", " + FirstName : "").</h2>
                        <p class="ct-hint">Thanks! We'll reply by email within a day.</p>
                        <div class="ct-actions">
                            <button type="button" class="ct-go" @onclick="ResetForm"><b>Send another</b></button>
                            <a href="/portfolio" class="ct-alt">See our work →</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ct-prog" role="progressbar" aria-label="Form progress" aria-valuemin="1" aria-valuemax="6" aria-valuenow="@(step + 1)">
                        @for (var i = 0; i <= Last; i++)
                        {
                            <i class="@(i < step ? "done" : i == step ? "now" : "")"></i>
                        }
                    </div>
                    <p class="ct-count">Step @(step + 1) of @(Last + 1)</p>

                    <form @onsubmit="OnSubmit" @onsubmit:preventDefault novalidate>
                        <div class="ct-step @(_animate ? (_back ? "back" : "fwd") : "")" @key="step">
                            @switch (step)
                            {
                                case 0:
                                    <h2 id="ct-q" class="ct-q">First things first. What's your name?</h2>
                                    <div class="ct-line">
                                        <input @ref="_input" class="ct-big" type="text" @bind="form.Name" @bind:event="oninput" placeholder="Type your name" autocomplete="name" maxlength="80" aria-labelledby="ct-q" />
                                    </div>
                                    @if (E("Name") is { } e0)
                                    {
                                        <p class="ct-err" role="alert">@e0</p>
                                    }
                                    break;

                                case 1:
                                    <h2 id="ct-q" class="ct-q">Nice to meet you, @FirstName. What's your email?</h2>
                                    <p class="ct-hint">We'll only use it to reply to you.</p>
                                    <div class="ct-line">
                                        <input @ref="_input" class="ct-big" type="email" inputmode="email" @bind="form.Email" @bind:event="oninput" placeholder="you@company.com" autocomplete="email" maxlength="254" aria-labelledby="ct-q" />
                                    </div>
                                    @if (E("Email") is { } e1)
                                    {
                                        <p class="ct-err" role="alert">@e1</p>
                                    }
                                    break;

                                case 2:
                                    <h2 id="ct-q" class="ct-q">Where are you based?</h2>
                                    <p class="ct-hint">So we can plan around your time zone.</p>
                                    <div class="ct-line">
                                        <select @ref="_input" class="ct-big ct-select" @bind="form.Country" @bind:after="SyncCode" autocomplete="country-name" aria-label="Country">
                                            <option value="" disabled>Choose your country</option>
                                            @foreach (var c in Countries)
                                            {
                                                <option value="@c.Name">@c.Flag @c.Name</option>
                                            }
                                        </select>
                                    </div>
                                    @if (E("Country") is { } e2)
                                    {
                                        <p class="ct-err" role="alert">@e2</p>
                                    }
                                    <div class="ct-line ct-gap">
                                        <input class="ct-big ct-medium" type="text" @bind="form.Address" @bind:event="oninput" placeholder="City or address" autocomplete="address-level2" maxlength="150" aria-label="City or address" />
                                    </div>
                                    @if (E("Address") is { } e2b)
                                    {
                                        <p class="ct-err" role="alert">@e2b</p>
                                    }
                                    break;

                                case 3:
                                    <h2 id="ct-q" class="ct-q">What's the best number to reach you?</h2>
                                    <p class="ct-hint">Only used to contact you about your project.</p>
                                    <div class="ct-phone">
                                        <div class="ct-line">
                                            <select class="ct-big ct-select ct-codesel" @bind="form.CountryCode" aria-label="Country calling code">
                                                @foreach (var c in Countries)
                                                {
                                                    <option value="@c.Code">@c.Flag @c.Code</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="ct-line">
                                            <input @ref="_input" class="ct-big" type="tel" inputmode="tel" @bind="form.PhoneNumber" @bind:event="oninput" placeholder="289 309-8905" autocomplete="tel-national" maxlength="20" aria-labelledby="ct-q" />
                                        </div>
                                    </div>
                                    @if (E("PhoneNumber") is { } e3)
                                    {
                                        <p class="ct-err" role="alert">@e3</p>
                                    }
                                    break;

                                case 4:
                                    <h2 id="ct-q" class="ct-q">What do you want to build?</h2>
                                    <div class="ct-chips" role="radiogroup" aria-labelledby="ct-q">
                                        @foreach (var t in Types)
                                        {
                                            var type = t;
                                            <button type="button" role="radio" aria-checked="@(form.ProjectType == type ? "true" : "false")" class="ct-chip @(form.ProjectType == type ? "on" : "")" @onclick="() => Pick(type)">
                                                <i aria-hidden="true">@ChipIcon(type)</i><b>@type</b>
                                            </button>
                                        }
                                    </div>
                                    @if (E("ProjectType") is { } e4)
                                    {
                                        <p class="ct-err" role="alert">@e4</p>
                                    }
                                    <div class="ct-line ct-gap">
                                        <textarea @ref="_input" class="ct-big ct-area" rows="4" @bind="form.Message" @bind:event="onchange" placeholder="Tell us a little about it..." maxlength="2000" aria-label="Project details"></textarea>
                                    </div>
                                    @if (E("Message") is { } e4b)
                                    {
                                        <p class="ct-err" role="alert">@e4b</p>
                                    }
                                    break;

                                default:
                                    <h2 id="ct-q" class="ct-q">Looks good? Take a last look.</h2>
                                    <ul class="ct-review">
                                        <li><small>Name</small><b>@form.Name</b><button type="button" @onclick="() => Edit(0)">Edit</button></li>
                                        <li><small>Email</small><b>@form.Email</b><button type="button" @onclick="() => Edit(1)">Edit</button></li>
                                        <li><small>Location</small><b>@form.Address, @form.Country</b><button type="button" @onclick="() => Edit(2)">Edit</button></li>
                                        <li><small>Phone</small><b>@form.CountryCode @form.PhoneNumber</b><button type="button" @onclick="() => Edit(3)">Edit</button></li>
                                        <li><small>Project</small><b>@form.ProjectType</b><button type="button" @onclick="() => Edit(4)">Edit</button></li>
                                    </ul>
                                    break;
                            }
                        </div>

                        <!-- honeypot: real people never see or fill this -->
                        <div class="ct-hp" aria-hidden="true">
                            <label>Leave this field empty<input type="text" tabindex="-1" autocomplete="off" @bind="form.Website" /></label>
                        </div>

                        <p class="ct-form-err" role="alert" aria-live="assertive">@errorMessage</p>

                        <div class="ct-actions">
                            @if (step > 0)
                            {
                                <button type="button" class="ct-back" @onclick="Back">← Back</button>
                            }
                            <button type="submit" class="ct-go" disabled="@sending" aria-busy="@(sending ? "true" : "false")">
                                @if (sending)
                                {
                                    <i class="ct-spin" aria-hidden="true"></i><b>Sending...</b>
                                }
                                else if (step == Last)
                                {
                                    <b>Send my brief</b>
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                                }
                                else
                                {
                                    <b>Continue</b>
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                                }
                            </button>
                            @if (step < Last && step != 2 && step != 4)
                            {
                                <span class="ct-key">press <kbd>Enter</kbd></span>
                            }
                        </div>
                        <p class="ct-privacy">Your details are sent over HTTPS and used only to reply to your enquiry.</p>
                    </form>
                }
            </section>

            <!-- ===== Live project brief ===== -->
            <aside class="ct-brief-wrap" aria-label="Your project brief preview">
                @if (submitted)
                {
                    <div class="ct-confetti" aria-hidden="true">
                        @for (var i = 0; i < 18; i++)
                        {
                            var ang = i * 20 * Math.PI / 180;
                            var dist = 130 + (i % 4) * 45;
                            <i style="--x:@((int)(Math.Cos(ang) * dist))px; --y:@((int)(Math.Sin(ang) * dist) - 40)px; --r:@(i * 47)deg; --i:@i; --c:@(_colors[i % 4]);"></i>
                        }
                    </div>
                }
                <div class="ct-brief">
                    <div class="ct-brief-head">
                        <b>Your project brief</b>
                        <small>@(submitted ? "Sent" : "Draft") &middot; @DateTime.UtcNow.ToString("d MMM yyyy")</small>
                    </div>
                    <ul>
                        <li><small>Name</small>@if (Has(form.Name)) {
                            <b>@form.Name</b>
                        } else
                        {

                            <u class="sk"></u>
                        }
                    </li>
                    <li><small>Email</small>@if (Has(form.Email)) {
                        <b>@form.Email</b>
                    } else
                    {

                        <u class="sk"></u>
                    }
                </li>
                <li><small>Location</small>@if (Has(form.Country) || Has(form.Address)) {
                    <b>@(string.Join(", ", new[] { form.Address, form.Country }.Where(Has)))</b>
                } else
                {

                    <u class="sk"></u>
                }
            </li>
            <li><small>Phone</small>@if (Has(form.PhoneNumber)) {
                <b>@form.CountryCode @form.PhoneNumber</b>
            } else
            {

                <u class="sk"></u>
            }
        </li>
        <li><small>Project</small>@if (Has(form.ProjectType)) {
            <b>@form.ProjectType</b>
        } else
        {

            <u class="sk"></u>
        }
    </li>
    <li><small>Details</small>@if (Has(form.Message)) {
        <b class="ct-clamp">@form.Message</b>
    } else
    {

        <u class="sk w2"></u>
    }
</li>
</ul>
<div class="ct-bars" aria-hidden="true"></div>
                    @if (submitted)
{
    <div class="ct-stamp" aria-hidden="true">Sent</div>
}
</div>

<ul class="ct-direct">
    <li><small>Prefer to write directly?</small></li>
    <li><a href="mailto:aliabdulsameea69@gmail.com">aliabdulsameea69@gmail.com</a></li>
    <li><a href="tel:+12893098905">+1 289 309 8905</a></li>
    <li><small>Reply time: within 24 hours</small></li>
</ul>
</aside>
</div>
</div>
</div>

<AiChat />

@code {
    private const int Last = 5;
    private static readonly string[] Types = { "Website", "Mobile app", "Business system", "Something else" };
    private static readonly string[] _colors = { "#00E5FF", "#3D7FFF", "#3DDC97", "#FFB020" };

    private ContactForm form = new();
    private bool submitted;
    private bool sending;
    private string? errorMessage;
    private string _jsonLd = "";
    private string _ip = "unknown";
    private DateTime _loadedAt = DateTime.UtcNow;
    private ElementReference doneHeading;
    private ElementReference _input;
    private bool _focusDone;
    private bool _focusNext;
    private int step;
    private bool _animate;
    private bool _back;
    private readonly Dictionary<string, string> errors = new();

    private string? E(string key) => errors.GetValueOrDefault(key);
    private static bool Has(string? s) => !string.IsNullOrWhiteSpace(s);

    private string FirstName
    {
        get
        {
            var n = (form.Name ?? "").Trim();
            var i = n.IndexOf(' ');
            n = i > 0 ? n[..i] : n;
            return n.Length > 30 ? n[..30] : n;
        }
    }

    private static MarkupString ChipIcon(string type) => new(type switch
    {
        "Website" => "<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='16' rx='2'/><path d='M3 9h18'/></svg>",
        "Mobile app" => "<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='7' y='2' width='10' height='20' rx='2'/><path d='M11 18h2'/></svg>",
        "Business system" => "<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 20V10M10 20V4M16 20v-7M22 20H2'/></svg>",
        _ => "<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18'/></svg>"
    });

    protected override void OnInitialized()
    {
        _loadedAt = DateTime.UtcNow;
        try
        {
            var ip = Services.GetService<IHttpContextAccessor>()?.HttpContext?.Connection.RemoteIpAddress;
            if (ip is not null) _ip = ip.ToString();
        }
        catch { /* HttpContext is not always available inside a circuit */ }

        var b = Nav.BaseUri.TrimEnd('/');
        var graph = new object[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "ContactPage", ["@id"] = b + "/contact#webpage", ["url"] = b + "/contact",
                ["name"] = "Contact CrossPlatformDev", ["inLanguage"] = "en",
                ["isPartOf"] = new Dictionary<string, object> { ["@id"] = b + "/#website" },
                ["about"] = new Dictionary<string, object> { ["@id"] = b + "/#business" }
            },
            new Dictionary<string, object>
            {
                ["@type"] = "ProfessionalService", ["@id"] = b + "/#business",
                ["name"] = "CrossPlatformDev", ["url"] = b + "/",
                ["email"] = "aliabdulsameea69@gmail.com", ["telephone"] = "+12893098905",
                ["areaServed"] = "Worldwide",
                ["contactPoint"] = new Dictionary<string, object>
                {
                    ["@type"] = "ContactPoint", ["contactType"] = "customer service",
                    ["email"] = "aliabdulsameea69@gmail.com", ["telephone"] = "+12893098905",
                    ["availableLanguage"] = new[] { "English", "Kurdish", "Arabic" }
                }
            },
            new Dictionary<string, object>
            {
                ["@type"] = "BreadcrumbList",
                ["itemListElement"] = new object[]
                {
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = b + "/" },
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Contact", ["item"] = b + "/contact" }
                }
            }
        };

        _jsonLd = JsonSerializer.Serialize(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@graph"] = graph
        }).Replace("<", "\\u003c");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDone)
        {
            _focusDone = false;
            try { await doneHeading.FocusAsync(); } catch { }
        }
        else if (_focusNext)
        {
            _focusNext = false;
            try { await _input.FocusAsync(); } catch { }
        }
    }

    // ----- step navigation -----
    private static string[] PropsFor(int s) => s switch
    {
        0 => new[] { "Name" },
        1 => new[] { "Email" },
        2 => new[] { "Country", "Address" },
        3 => new[] { "PhoneNumber" },
        4 => new[] { "ProjectType", "Message" },
        _ => Array.Empty<string>()
    };

    private string? Check(string prop)
    {
        var pi = typeof(ContactForm).GetProperty(prop)!;
        var results = new List<ValidationResult>();
        Validator.TryValidateProperty(pi.GetValue(form), new ValidationContext(form) { MemberName = prop }, results);
        if (results.Count > 0) return results[0].ErrorMessage;
        if (prop == "ProjectType" && !Types.Contains(form.ProjectType)) return "Please pick what you want to build.";
        if (prop == "Country" && !Countries.Any(c => c.Name == form.Country)) return "Please choose your country from the list.";
        return null;
    }

    private bool ValidateStep(int s)
    {
        errors.Clear();
        foreach (var p in PropsFor(s))
        {
            var m = Check(p);
            if (m is not null) errors[p] = m;
        }
        return errors.Count == 0;
    }

    private void Go(int to, bool back)
    {
        errors.Clear();
        errorMessage = null;
        step = Math.Clamp(to, 0, Last);
        _back = back;
        _animate = true;
        _focusNext = true;
    }

    private void Next()
    {
        if (sending || !ValidateStep(step)) return;
        Go(step + 1, false);
    }

    private void Back() => Go(step - 1, true);
    private void Edit(int s) => Go(s, true);

    private void Pick(string type)
    {
        form.ProjectType = type;
        errors.Remove("ProjectType");
    }

    private void SyncCode()
    {
        var match = Countries.FirstOrDefault(c => c.Name == form.Country);
        if (match is not null) form.CountryCode = match.Code;
    }

    private void ResetForm()
    {
        submitted = false;
        form = new ContactForm();
        errors.Clear();
        errorMessage = null;
        step = 0;
        _animate = true;
        _back = true;
        _loadedAt = DateTime.UtcNow;
    }

    private async Task OnSubmit()
    {
        if (step < Last) Next();
        else await Send();
    }

    // ----- sending (security checks unchanged) -----
    private async Task Send()
    {
        if (sending) return;
        errorMessage = null;

        // Every earlier step must be valid; jump back to the first one that is not.
        for (var s = 0; s < Last; s++)
        {
            if (!ValidateStep(s))
            {
                Go(s, true);
                foreach (var p in PropsFor(s)) { var m = Check(p); if (m is not null) errors[p] = m; }
                errorMessage = "Please check this step and continue.";
                return;
            }
        }

        // Honeypot filled: almost certainly a bot. Pretend it worked, send nothing.
        if (!string.IsNullOrWhiteSpace(form.Website))
        {
            submitted = true;
            return;
        }

        // A form filled and sent within 3 seconds of loading is not a person.
        if ((DateTime.UtcNow - _loadedAt).TotalSeconds < 3)
        {
            errorMessage = "Please take a moment to check your details, then send again.";
            return;
        }

        if (!Countries.Any(c => c.Name == form.Country) || !Countries.Any(c => c.Code == form.CountryCode) || !Types.Contains(form.ProjectType))
        {
            errorMessage = "Something in the form looks wrong. Please go back and check it.";
            return;
        }

        var name = Clean(form.Name, 80);
        var email = Clean(form.Email, 254).ToLowerInvariant();
        var phone = Clean($"{form.CountryCode} {form.PhoneNumber}", 30);
        var address = Clean(form.Address, 150);
        var message = Clean(form.Message, 2000, multiline: true);

        if (!Allow("ip:" + _ip, 5, TimeSpan.FromHours(1)) ||
            !Allow("mail:" + email, 3, TimeSpan.FromHours(1)) ||
            !Allow("all", 60, TimeSpan.FromHours(1)))
        {
            errorMessage = "Too many messages were sent. Please try again later or email us directly.";
            return;
        }

        sending = true;
        try
        {
            var apiKey = Config["Resend:ApiKey"];
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                Logger.LogWarning("Contact form: Resend:ApiKey is not configured.");
                errorMessage = "We couldn't send your message right now. Please email us directly instead.";
                return;
            }

            var body = $"Name: {name}\nEmail: {email}\nPhone: {phone}\nCountry: {form.Country}\nAddress: {address}\n" +
                       $"Project type: {form.ProjectType}\nSent: {DateTime.UtcNow:u}\nIP: {_ip}\n\nMessage:\n{message}";

            var payload = new
            {
                from = Config["Contact:From"] ?? "CrossPlatformDev Contact Form <onboarding@resend.dev>",
                to = new[] { Config["Contact:To"] ?? "aliabdulsameea69@gmail.com" },
                reply_to = email,
                subject = $"New inquiry from {name}",
                text = body
            };

            var client = HttpClientFactory.CreateClient("Resend");
            client.Timeout = TimeSpan.FromSeconds(15);
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", apiKey);

            var response = await client.PostAsJsonAsync("emails", payload);
            if (response.IsSuccessStatusCode)
            {
                submitted = true;
                _focusDone = true;
            }
            else
            {
                Logger.LogError("Contact form: email provider returned {Status}.", (int)response.StatusCode);
                errorMessage = "We couldn't send your message right now. Please email us directly instead.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Contact form: sending failed.");
            errorMessage = "We couldn't send your message right now. Please email us directly instead.";
        }
        finally
        {
            sending = false;
        }
    }

    // ----- input cleaning: strip control characters and line breaks, enforce length -----
    private static string Clean(string? s, int max, bool multiline = false)
    {
        if (string.IsNullOrEmpty(s)) return "";
        var sb = new StringBuilder(Math.Min(s.Length, max));
        foreach (var ch in s)
        {
            if (sb.Length >= max) break;
            if (ch == '\r') continue;
            if (ch == '\n') { sb.Append(multiline ? '\n' : ' '); continue; }
            sb.Append(char.IsControl(ch) ? ' ' : ch);
        }
        return sb.ToString().Trim();
    }

    // ----- simple in-memory rate limiter (per IP, per email, and overall) -----
    private static readonly object _gate = new();
    private static readonly Dictionary<string, List<DateTime>> _hits = new();

    private static bool Allow(string key, int limit, TimeSpan window)
    {
        var now = DateTime.UtcNow;
        lock (_gate)
        {
            if (_hits.Count > 5000)
            {
                foreach (var k in _hits.Where(p => p.Value.All(t => now - t > TimeSpan.FromDays(1))).Select(p => p.Key).ToList())
                    _hits.Remove(k);
            }
            if (!_hits.TryGetValue(key, out var list)) _hits[key] = list = new List<DateTime>();
            list.RemoveAll(t => now - t > window);
            if (list.Count >= limit) return false;
            list.Add(now);
            return true;
        }
    }

    public class ContactForm
    {
        [Required(ErrorMessage = "Please tell us your name.")]
        [StringLength(80, MinimumLength = 2, ErrorMessage = "Name must be 2 to 80 characters.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Please choose your country.")]
        public string Country { get; set; } = "";

        [Required(ErrorMessage = "Please enter your email.")]
        [EmailAddress(ErrorMessage = "That doesn't look like a valid email.")]
        [StringLength(254, ErrorMessage = "That email is too long.")]
        public string Email { get; set; } = "";

        public string CountryCode { get; set; } = "+1";

        [Required(ErrorMessage = "Please enter your phone number.")]
        [RegularExpression(@"^[0-9 ()\-]{6,20}$", ErrorMessage = "Use digits only, 6 to 20 characters.")]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessage = "Please enter your city or address.")]
        [StringLength(150, MinimumLength = 2, ErrorMessage = "Please enter 2 to 150 characters.")]
        public string Address { get; set; } = "";

        [Required(ErrorMessage = "Please pick what you want to build.")]
        public string ProjectType { get; set; } = "";

        [Required(ErrorMessage = "Please tell us a little about your project.")]
        [StringLength(2000, MinimumLength = 10, ErrorMessage = "Please write 10 to 2000 characters.")]
        public string Message { get; set; } = "";

        // honeypot
        public string Website { get; set; } = "";
    }

